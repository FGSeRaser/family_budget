rules_version = '2';
// FamilyBudget – Firestore-Regeln
// von FGSeRaser (https://github.com/FGSeRaser)
//
// Einspielen: Firebase Console -> Firestore -> Regeln -> alles ersetzen -> Veröffentlichen
//        oder: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function memberPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function isMember(familyId) {
      return signedIn() && exists(memberPath(familyId));
    }

    function isOwner(familyId) {
      return isMember(familyId) &&
        get(memberPath(familyId)).data.get('role', 'member') in ['owner', 'admin'];
    }

    // Persönliche Daten (z. B. welche Familie zu einem gesicherten Konto gehört)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Familien-Code -> Familie
    match /familyCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.familyId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && isOwner(resource.data.familyId);
    }

    // Einladungs-Token (QR, einmalig, läuft ab)
    match /inviteTokens/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.familyId is string
        && isMember(request.resource.data.familyId);
      allow update: if false;
      // Löschen nur durch Mitglieder der Familie oder durch den, der gerade damit beitritt
      // (vorher durfte jeder angemeldete Nutzer fremde Einladungen löschen)
      allow delete: if signedIn() && (
        isMember(resource.data.familyId) ||
        existsAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid))
      );
    }

    match /families/{familyId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow get: if isMember(familyId);
      allow list: if false;
      // Alle Mitglieder dürfen Budgets usw. ändern, aber nicht Code oder Gründer
      allow update: if isMember(familyId)
        && request.resource.data.get('code', null) == resource.data.get('code', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      allow delete: if false;

      match /members/{uid} {
        allow get: if isMember(familyId) || (signedIn() && request.auth.uid == uid);
        allow list: if isMember(familyId);

        // Owner/Admin verwaltet Mitglieder
        allow create, update, delete: if isOwner(familyId);

        // Gründer trägt sich beim Erstellen der Familie selbst als Owner ein
        allow create: if signedIn() && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid;

        // Beitritt mit gültigem Einladungs-Token
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == 'member'
          && request.resource.data.inviteToken is string
          && get(/databases/$(database)/documents/inviteTokens/$(request.resource.data.inviteToken)).data.familyId == familyId
          && get(/databases/$(database)/documents/inviteTokens/$(request.resource.data.inviteToken)).data.expiresAt > request.time;

        // Eigenen Namen/Avatar ändern (Rolle bleibt gleich) und selbst austreten
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.get('role', 'member') == resource.data.get('role', 'member');
        allow delete: if signedIn() && request.auth.uid == uid;

        // Schicht-Profile (Früh/Spät/Nacht): Familie sieht sie, nur man selbst ändert sie
        match /shiftProfiles/{profileId} {
          allow read: if isMember(familyId);
          allow write: if isMember(familyId) && request.auth.uid == uid;
        }
      }

      match /joinRequests/{uid} {
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow get: if (signedIn() && request.auth.uid == uid) || isOwner(familyId);
        allow list: if isOwner(familyId);
        allow update: if isOwner(familyId)
          || (signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending');
        allow delete: if (signedIn() && request.auth.uid == uid) || isOwner(familyId);
      }

      // Arbeitszeiten: alle Mitglieder lesen, jeder schreibt nur seine eigenen
      match /work/{uid}/days/{dayId} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId) && request.auth.uid == uid;
      }

      // Stoppuhr/Schicht-Einträge: Familie liest, jeder schreibt nur seine eigenen
      match /workEntries/{entryId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isMember(familyId) && resource.data.uid == request.auth.uid
          && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      }

      // Termine: Familie liest, jeder ändert nur seine eigenen
      match /appointments/{appId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isMember(familyId) && resource.data.uid == request.auth.uid;
      }

      // Tagebuch ist privat: nur der Verfasser liest und schreibt
      match /diary/{entryId} {
        allow read, update, delete: if isMember(familyId) && resource.data.uid == request.auth.uid;
        allow create: if isMember(familyId) && request.resource.data.uid == request.auth.uid;
      }

      // Alle übrigen Familien-Daten
      match /{sub}/{docId} {
        allow read, write: if isMember(familyId) && sub in [
          'tx', 'accounts', 'categories', 'recurring_rules', 'taxProfiles',
          'budgets', 'incomeEntries', 'payments', 'transactions', 'shopping_items'
        ];
      }
    }
  }
}
